# =============================================================================
# SAPIENS — Environment variables
# Copy to .env.local for development
# Set the same keys in Vercel Project Settings → Environment Variables
# =============================================================================

# --- NASA ADS (required for full literature results) ---
# Get token: https://ui.adsabs.harvard.edu → Account → Settings → API Token
ADS_API_TOKEN=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional alias
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# --- Sapiens AI (optional generative layer) ---
# Without these, AI answers are extractive (titles/metadata only) — still grounded.
# OpenAI-compatible: OpenAI, xAI, etc.
# AI_API_KEY=
# AI_BASE_URL=https://api.x.ai/v1
# AI_MODEL=grok-3
# Or: OPENAI_API_KEY= / XAI_API_KEY=
